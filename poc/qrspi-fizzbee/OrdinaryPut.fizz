---
options:
  max_actions: 20
  max_concurrent_actions: 1
  crash_on_yield: false
deadlock_detection: false
liveness: strict
---
CLAIM_EXACTLY_ONCE = False

action Init:
    stage = [0, 0]
    store = -1
    admitted = [False, False]

atomic action PreRead:
    w = oneof [i for i in range(2) if stage[i] == 0]
    stage[w] = 1 if store == -1 else 3

atomic action OrdinaryPut:
    w = oneof [i for i in range(2) if stage[i] == 1]
    store = w
    stage[w] = 2

atomic action ReadBack:
    w = oneof [i for i in range(2) if stage[i] == 2]
    admitted[w] = store == w
    stage[w] = 3

always assertion CannotClaimExactlyOnce:
    return not CLAIM_EXACTLY_ONCE or admitted != [True, True]

exists assertion OverlappingWritersBothAdmit:
    return admitted == [True, True]
