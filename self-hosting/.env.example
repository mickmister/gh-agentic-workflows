COMPOSE_PROJECT_NAME=agentic
GITEA_HOST=git.example.com
APP_HOST=agents.example.com
S3_HOST=objects.example.com
PAGES_DOMAIN=pages.example.com
TLS_EMAIL=operator@example.com
HTTP_PORT=80
HTTPS_PORT=443
GITEA_SSH_PORT=2222
# Must be unique if more than one installation shares the VM daemon.
JOB_NETWORK=agentic-jobs
WORKER_IMAGE=agentic-worker:opencode-1.19.4
RUNNER_CAPACITY=2
# Read source from this repository; the pilot never infers membership from prompts.
SOURCE_REPOSITORY=pilot/source
SOURCE_REF=main
WORKFLOW_REPOSITORY=pilot/workflows
WORKFLOW_REF=main
# For a GitHub Ultimate source checkout use:
# HOSTED_BUILD_COMMAND=pnpm install --frozen-lockfile && pnpm run pages:build
# Empty selects the new fixture repository's static index.html copy.
HOSTED_BUILD_COMMAND=
INFERENCE_BASE_URL=https://your-provider.example/v1
INFERENCE_MODEL=gpt-6.1-sol
